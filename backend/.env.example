APP_NAME=StringSense Backend
APP_ENV=development
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
PORT=3001

# Unified Python backend
DATABASE_URL=postgresql+psycopg://admin:admin@127.0.0.1:55432/stringsense
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=stringsense-python-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
STORE_TIMEZONE=Asia/Kuala_Lumpur
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10
PASSWORD_RESET_CODE_MAX_ATTEMPTS=5
PASSWORD_RESET_DEV_PREVIEW_ENABLED=false
APPROVED_STRINGS_SOURCE_PATH=data/string_catalog_db_ready.json
RECOMMENDATION_MATRIX_SOURCE_PATH=../ml/nlp-workbench-latest/output/latest_macbert_review_matrix_system12.xlsx
UPLOAD_ROOT_PATH=var/uploads

# Optional CORS override
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional admin seed
SEED_ADMIN_ENABLED=false
SEED_ADMIN_USERNAME=replace-with-admin-username
SEED_ADMIN_PHONE_NUMBER=replace-with-admin-phone
SEED_ADMIN_PASSWORD=replace-with-admin-password

# Standalone AI-service compatibility settings for canonical latest NLP outputs.
AI_INTERNAL_API_KEY=replace-with-long-random-internal-key
AI_MATRIX_CSV_PATH=../ml/nlp-workbench-latest/output/latest_practical_string_feature_matrix_v8_v6dict.csv
# AI_REVIEW_ASPECT_CSV_PATH is optional and must point to an actual promoted CSV.
AI_FALLBACK_JSONL_PATH=./data/raw/badminton_strings_recommender.jsonl
