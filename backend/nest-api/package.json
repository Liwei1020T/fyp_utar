{
  "name": "stringsense-nest-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS business backend for StringSense",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --test test/**/*.test.js",
    "prisma:generate": "node scripts/run-prisma-with-backend-env.cjs generate",
    "prisma:migrate:dev": "node scripts/run-prisma-with-backend-env.cjs migrate dev",
    "prisma:push": "node scripts/run-prisma-with-backend-env.cjs db push"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^6.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
