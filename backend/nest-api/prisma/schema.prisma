generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
  vendor
}

enum AuthProvider {
  local
  firebase_future_ready
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  ready_for_pickup
  picked_up
  cancelled
  rejected
}

model User {
  id               String                 @id @default(uuid())
  phoneNumber      String                 @unique @map("phone_number")
  username         String                 @map("username")
  passwordHash     String                 @map("password_hash")
  role             UserRole               @default(customer)
  authProvider     AuthProvider           @default(local) @map("auth_provider")
  externalAuthId   String?                @unique @map("external_auth_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  profile          UserProfile?
  bookings         Booking[]
  statusChanges    BookingStatusHistory[] @relation("BookingStatusChangedBy")
  recommendationLogs RecommendationLog[]

  @@map("users")
}

model UserProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  skillLevel            String?  @map("skill_level")
  playingStyle          String?  @map("playing_style")
  budgetMin             Decimal? @map("budget_min")
  budgetMax             Decimal? @map("budget_max")
  preferredTension      Decimal? @map("preferred_tension")
  gameType              String?  @map("game_type")
  frequencyPerWeek      Int?     @map("frequency_per_week")
  prefAttack            Int?     @map("pref_attack")
  prefComfort           Int?     @map("pref_comfort")
  prefControl           Int?     @map("pref_control")
  prefDurability        Int?     @map("pref_durability")
  prefElasticity        Int?     @map("pref_elasticity")
  prefSound             Int?     @map("pref_sound")
  prefStringMovement    Int?     @map("pref_string_movement")
  prefTensionRetention  Int?     @map("pref_tension_retention")
  prefValueForMoney     Int?     @map("pref_value_for_money")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model StringCatalogItem {
  id                  String    @id @default(uuid())
  brand               String
  modelName           String    @map("model_name")
  normalizedName      String    @unique @map("normalized_name")
  priceRm             Decimal?  @map("price_rm")
  attack              Decimal?
  comfort             Decimal?
  control             Decimal?
  durability          Decimal?
  elasticity          Decimal?
  sound               Decimal?
  stringMovement      Decimal?  @map("string_movement")
  tensionRetention    Decimal?  @map("tension_retention")
  valueForMoney       Decimal?  @map("value_for_money")
  beginnerFitScore    Decimal?  @map("beginner_fit_score")
  stabilityScore      Decimal?  @map("stability_score")
  allRoundScore       Decimal?  @map("all_round_score")
  sourceItemId        String?   @map("source_item_id")
  sourceUrl           String?   @map("source_url")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  bookings            Booking[]

  @@map("strings")
}

model Booking {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  stringId         String               @map("string_id")
  racketBrand      String?              @map("racket_brand")
  racketModel      String?              @map("racket_model")
  requestedTension Decimal?             @map("requested_tension")
  dropOffDatetime  DateTime?            @map("drop_off_datetime")
  notes            String?
  status           BookingStatus        @default(pending)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  string           StringCatalogItem    @relation(fields: [stringId], references: [id])
  statusHistory    BookingStatusHistory[]

  @@map("bookings")
}

model BookingStatusHistory {
  id              String         @id @default(uuid())
  bookingId       String         @map("booking_id")
  oldStatus       BookingStatus? @map("old_status")
  newStatus       BookingStatus  @map("new_status")
  changedByUserId String?        @map("changed_by_user_id")
  changedAt       DateTime       @default(now()) @map("changed_at")
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy       User?          @relation("BookingStatusChangedBy", fields: [changedByUserId], references: [id])

  @@map("booking_status_history")
}

model RecommendationLog {
  id                       String   @id @default(uuid())
  userId                   String?  @map("user_id")
  profileSnapshotJson      Json     @map("profile_snapshot_json")
  recommendationResultJson Json     @map("recommendation_result_json")
  algorithmVersion         String   @map("algorithm_version")
  createdAt                DateTime @default(now()) @map("created_at")
  user                     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("recommendation_logs")
}
