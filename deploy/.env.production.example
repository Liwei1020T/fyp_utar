# Copy this file to deploy/.env.production and replace every replace-* value.
POSTGRES_DB=stringsense
POSTGRES_USER=stringsense_app
POSTGRES_PASSWORD=replace-with-48-hex-characters
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=stringsense-python-api

# Cloudflare public API hostname and the HTTPS origins allowed to call it.
TRUSTED_HOSTS=api.example.com,127.0.0.1,localhost,backend
CORS_ORIGINS=https://app.example.com

# Enable once with real values to create the first admin, then turn it off.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_USERNAME=replace-with-admin-username
SEED_ADMIN_PHONE_NUMBER=replace-with-admin-phone
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# WhatsApp/OpenWA remains disabled until its separate real-device acceptance.
OPENWA_ENABLED=false

AGENT_ENABLED=false
AGENT_API_KEY=
AGENT_MODEL=deepseek-v4-flash
AGENT_BASE_URL=https://api.deepseek.com

# Create the remotely-managed tunnel in Cloudflare first, then paste its token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
